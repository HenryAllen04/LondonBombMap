{
  "name": "london-before",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "node scripts/build-pimlico-index.mjs && node scripts/copy-maplibre-worker.mjs && next dev --hostname 0.0.0.0 --port 3020",
    "build": "node scripts/build-pimlico-index.mjs && node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 3020",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark:pimlico": "node scripts/build-pimlico-index.mjs && node scripts/pimlico-benchmark.mjs",
    "index:pimlico": "node scripts/build-pimlico-index.mjs",
    "check:registration": "node scripts/check-pimlico-registration.mjs"
  },
  "dependencies": {
    "dialkit": "^2.0.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.8.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "pbf": "^5.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
